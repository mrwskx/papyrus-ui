{
  "name": "papyrus-ui-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23 || >=24"
  },
  "scripts": {
    "docs": "storybook dev --no-open -p 6006",
    "build": "pnpm build:papyrus-ui && pnpm build:docs",
    "build:docs": "storybook build",
    "build:papyrus-ui": "lerna run --scope papyrus-ui --stream build",
    "check:licenses": "license-checker --production --summary --failOn=GPLv3",
    "ci:release": "lerna publish from-package --yes",
    "ci:versionup:patch": "lerna version patch --no-push --no-git-tag-version --yes && pnpm commit-version",
    "ci:versionup:minor": "lerna version minor --no-push --no-git-tag-version --yes && pnpm commit-version",
    "ci:versionup:major": "lerna version major --no-push --no-git-tag-version --yes && pnpm commit-version",
    "commit": "node @commitlint/prompt-cli/cli.js",
    "commit-version": "git add -u && git commit -m \"chore(release): v`node -p \"require('./lerna.json').version\"`\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --cache --max-warnings 0",
    "lint:fix": "eslint . --cache --fix",
    "prepare": "husky",
    "release": "lerna publish from-package",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "validate-skills": "tsx scripts/validate-skills/index.ts",
    "versionup": "lerna version"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@faker-js/faker": "^8.4.1",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-typescript": "^11.0.0",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-mdx-gfm": "^8.6.14",
    "@storybook/addon-storysource": "^8.6.14",
    "@storybook/addon-themes": "^8.6.14",
    "@storybook/manager-api": "^8.6.14",
    "@storybook/preview-api": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/theming": "^8.6.14",
    "@swc/core": "^1.3.40",
    "@testing-library/dom": "^9.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "autoprefixer": "^10.4.21",
    "boxicons": "^2.1.4",
    "classnames": "^2.3.1",
    "cross-env": "^7.0.3",
    "css-loader": "^6.7.3",
    "eslint": "^10.8.1",
    "eslint-config-airbnb-extended": "^3.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.5.10",
    "glob": "^9.3.2",
    "globals": "^15.0.0",
    "husky": "^9.1.7",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "lerna": "^8.2.2",
    "license-checker": "^25.0.1",
    "lodash": "^4.17.21",
    "papyrus-ui": "workspace:*",
    "postcss": "^8.4.39",
    "prettier": "^3.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^3.0.2",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-delete": "^2.0.0",
    "rollup-plugin-node-externals": "^5.1.2",
    "rollup-plugin-postcss": "^4.0.2",
    "storybook": "^8.6.14",
    "tailwindcss": "3.x.x",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.8.0"
}
