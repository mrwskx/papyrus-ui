{
  "name": "papyrus-ui",
  "version": "0.10.1",
  "description": "The UI kit with fundamental React components based on the Papyrus UI design system.",
  "author": "Sergey Murawsky",
  "license": "MIT",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/mrwskx/papyrus-ui.git"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "types": "dist/types/index.d.ts",
  "main": "dist/cjs/index.js",
  "module": "dist/es/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./plugin": {
      "types": "./dist/types/plugin/index.d.ts",
      "import": "./dist/es/plugin/index.js",
      "require": "./dist/cjs/plugin/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.16.0 <23 || >=24"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "build": "vite build",
    "build:storybook": "storybook build",
    "check:licenses": "license-checker --production --summary --failOn=GPLv3",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --cache --max-warnings 0",
    "lint:fix": "eslint . --cache --fix",
    "prepare": "husky",
    "storybook": "storybook dev --no-open -p 6006",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "validate-skills": "tsx scripts/validate-skills/index.ts"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "tailwindcss": "^3 || ^4"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.7",
    "@react-hook/debounce": "^4.0.0",
    "classnames": "^2.3.1",
    "copy-to-clipboard": "^3.3.3",
    "lodash": "^4.17.21",
    "react-dropzone": "^14.3.8",
    "react-icons": "5.4.0",
    "react-number-format": "^5.3.1",
    "react-transition-group": "^4.4.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@faker-js/faker": "^8.4.1",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-mdx-gfm": "^8.6.14",
    "@storybook/addon-storysource": "^8.6.14",
    "@storybook/addon-themes": "^8.6.14",
    "@storybook/manager-api": "^8.6.14",
    "@storybook/preview-api": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/theming": "^8.6.14",
    "@testing-library/dom": "^9.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/lodash": "^4.14.182",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-transition-group": "^4.4.6",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.8.1",
    "eslint-config-airbnb-extended": "^3.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.5.10",
    "globals": "^15.0.0",
    "husky": "^9.1.7",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "license-checker": "^25.0.1",
    "postcss": "^8.4.39",
    "prettier": "^3.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "storybook": "^8.6.14",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.11"
  }
}
